# Khybersoft Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# APPLICATION
# ============================================

APP_ENV=production
APP_DEBUG=false
APP_KEY=

# ============================================
# DATABASE
# ============================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=khybersoft_db
DB_USER=your_database_user
DB_PASS=your_database_password

# ============================================
# SITE
# ============================================

SITE_URL=https://yourdomain.com
SITE_NAME=Khybersoft

# ============================================
# EMAIL (SMTP)
# ============================================

SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Khybersoft
SMTP_ENCRYPTION=tls

# ============================================
# PAYMENT - STRIPE
# ============================================

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# PAYMENT - PAYPAL
# ============================================

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live

# ============================================
# RECAPTCHA
# ============================================

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ============================================
# GOOGLE SERVICES
# ============================================

GOOGLE_MAPS_API_KEY=
GOOGLE_ANALYTICS_ID=
GOOGLE_SEARCH_CONSOLE=

# ============================================
# SOCIAL MEDIA
# ============================================

SOCIAL_FACEBOOK=
SOCIAL_TWITTER=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=
SOCIAL_GITHUB=
SOCIAL_INSTAGRAM=

# ============================================
# LIVE CHAT
# ============================================

CHAT_PROVIDER=
CHAT_WIDGET_ID=

# ============================================
# WHATSAPP
# ============================================

WHATSAPP_NUMBER=

# ============================================
# CONTACT
# ============================================

CONTACT_EMAIL=info@yourdomain.com
CONTACT_PHONE=+1-234-567-8900
CONTACT_ADDRESS=Your Business Address

# ============================================
# ANNOUNCEMENT BAR
# ============================================

ANNOUNCEMENT_ENABLED=0
ANNOUNCEMENT_TEXT=
ANNOUNCEMENT_LINK=

# ============================================
# APPEARANCE
# ============================================

PRIMARY_COLOR=#4F46E5
FOOTER_TEXT=© 2024 Khybersoft. All rights reserved.

# ============================================
# SECURITY
# ============================================

SESSION_LIFETIME=120
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=900

# ============================================
# PERFORMANCE
# ============================================

CACHE_ENABLED=true
CACHE_TTL=3600

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=error
LOG_CHANNEL=single

# ============================================
# BACKUP
# ============================================

BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION=30
